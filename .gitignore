# ==========================================
# Comprehensive .gitignore for CASE UML Platform
# ==========================================

# ------------------------------------------
# 1. Dependencias de Node.js / NPM
# ------------------------------------------
node_modules/
*/node_modules/
**/node_modules/

# ------------------------------------------
# 2. Compilaciones y Artefactos de Producción
# ------------------------------------------
dist/
build/
*/dist/
*/build/
**/dist/
**/build/
*.tsbuildinfo

# ------------------------------------------
# 3. Variables de Entorno y Claves Privadas
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
server/.env
frontend/.env

# ------------------------------------------
# 4. Archivos Temporales y Pruebas
# ------------------------------------------
tmp/
temp/
**/tmp/
**/temp/
**/uploads/
out-smoke*
*.zip
*.tar.gz
*.tgz
body.json
coverage/
.nyc_output

# ------------------------------------------
# 5. Logs
# ------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ------------------------------------------
# 6. IDEs y Editores de Código
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------------------
# 7. Archivos del Sistema Operativo
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------
# 8. Artefactos Generados (Spring Boot / Flutter / DB)
# ------------------------------------------
target/
*.jar
*.war
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
*.apk
*.aab
*.ipa
*.sqlite
*.sqlite3
*.db