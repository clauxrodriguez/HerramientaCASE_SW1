{
  "name": "uml-diagram-server",
  "version": "1.0.0",
  "description": "Backend server for UML Diagram Tool",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "build:frontend": "cd ../frontend && npm run build",
    "build:all": "npm run build:frontend && npm run build",
    "start": "node dist/index.js",
    "test": "jest"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "axios": "^1.13.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^7.1.0",
    "mime-types": "^3.0.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.20.1",
    "pg": "^8.16.3",
    "sharp": "^0.34.4",
    "socket.io": "^4.7.4",
    "tesseract.js": "^6.0.1",
    "uuid": "^9.0.1",
    "adm-zip": "^0.5.10"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/mime-types": "^3.0.1",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.24",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^9.0.7",
    "@types/adm-zip": "^0.5.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
